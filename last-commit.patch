+            trySolveWafChallenge()?.let { cookie ->
+                saveWafCookie(cookie)
+                runCatching { CookieManager.getInstance().setCookie(baseUrl, cookie) }
+                return cookie
+            }
+        }
+        saveWafCookie(null)
+        return null
+    }
